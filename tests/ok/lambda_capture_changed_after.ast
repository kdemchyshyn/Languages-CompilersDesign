Program
  Decl k i32 mut
    Const 10
  Lambda add_k -> i32
    Capture k
    Param y i32
    Block
      Decl r i32 const
        BinOp +
          Var k
          Var y
      Exit
        Var r
  Assign k
    Const 100
  Print
    Call add_k
      Const 5
  Print
    Var k
  Exit
    Call add_k
      Const 1