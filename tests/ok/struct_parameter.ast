Program
  Struct Point
    Member x i32 const
    Member y i32 const
  Function sum_coords i32
    Param p Point
    Block
      Decl res i32 const
        InitList
          BinOp +
            Field p.x
            Field p.y
      Exit
        Var res
  Decl pt Point const
    InitList
      Const 15
      Const 25
  Exit
    Call sum_coords
      Var pt
