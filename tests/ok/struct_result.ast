Program
  Struct Point
    FieldDecl x i32 const
    FieldDecl y i32 const
  Function make_point Point
    Param x i32
    Param y i32
    Block
      Decl p Point const
        Var x
        Var y
      Exit
        Var p
  Decl pt Point const
    Call make_point
      Const 35
      Const 45
  Decl res i32 const
    BinOp +
      Field pt.x
      Field pt.y
  Exit
    Var res
