factor     ::= number | ident | "true" | "false"
type       ::= "i32" | "i64" | "bool"

term       ::= factor { "*" factor }
arith      ::= term { ("+" | "-") term }
expr       ::= arith [ ("==" | "!=") arith ] 

decl       ::= type [ "mut" ] ident "{" expr "}"
assign     ::= ident ":=" expr
exit       ::= "exit" factor

statement  ::= decl | assign
program    ::= { statement } exit